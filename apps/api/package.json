{
  "name": "@mytutor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/node.ts",
    "start": "tsx src/node.ts",
    "dev:worker": "wrangler dev --port 8787",
    "check:worker": "node scripts/check-worker.mjs",
    "deploy:demo-api": "node scripts/deploy-demo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@mytutor/demo-data": "workspace:*",
    "@mytutor/schemas": "workspace:*",
    "@mytutor/types": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mytutor/config": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "4.151.1"
  }
}
