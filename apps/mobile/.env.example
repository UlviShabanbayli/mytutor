# Copy to .env. The API's address as the app sees it: on a phone use the computer's
# address on the network (e.g. http://192.168.0.190:4000), not localhost, or the hosted demo
# API (https://ari-demo-api.<account>.workers.dev). Unreachable: the app uses its own demo data.
EXPO_PUBLIC_API_URL=http://localhost:4000
