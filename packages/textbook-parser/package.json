{
  "name": "@mytutor/textbook-parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "split-textbook": "./src/cli.ts"
  },
  "scripts": {
    "split": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "source": "tsx src/sourceCli.ts"
  },
  "dependencies": {
    "@mytutor/schemas": "workspace:*",
    "@napi-rs/canvas": "^1.0.10",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mytutor/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
