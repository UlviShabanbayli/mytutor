{
  "name": "mytutor",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --ui=tui --filter=@mytutor/api --filter=@mytutor/mobile",
    "dev:worker": "pnpm --filter @mytutor/api dev:worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:demo-api": "pnpm --filter @mytutor/api deploy:demo-api"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
